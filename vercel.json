{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client/",
      "framework": "angular",
      "installCommand": "npx --yes npm@11.6.2 ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/client/browser",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "installCommand": "npx --yes npm@11.6.2 ci",
      "buildCommand": "npm run build:vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ],
  "crons": [
    { "path": "/api/cron/jobs", "schedule": "0 7 * * *" }
  ]
}
