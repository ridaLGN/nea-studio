# --- Core ---
NODE_ENV=development
PORT=4000
# Postgres from docker-compose (port 5433 to avoid clashing with other local servers)
DATABASE_URL=postgresql://nea:nea_dev_password@localhost:5433/nea_studio?schema=public
# Used only by `npm test` (integration tests wipe this database)
TEST_DATABASE_URL=postgresql://nea:nea_dev_password@localhost:5433/nea_studio_test?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4200
PUBLIC_APP_URL=http://localhost:4200

# --- Seed (demo admin). Change before seeding any real environment ---
SEED_ADMIN_EMAIL=admin@neastudio.demo
SEED_ADMIN_PASSWORD=NeaAdmin!2026

# --- Email (SMTP). Leave SMTP_HOST empty => emails are logged as NOT_CONFIGURED, never "sent" ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NÉA STUDIO <no-reply@example.com>"

# --- WhatsApp Business Cloud API (Meta). Leave empty => NOT_CONFIGURED ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved template name with body params {{1}} = message text (see README)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# --- Background jobs ---
JOBS_ENABLED=true
REMINDER_HOURS_BEFORE=24
