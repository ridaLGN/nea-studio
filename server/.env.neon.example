# NÉA STUDIO — Neon (production) database connections
# ----------------------------------------------------------------------------
# Copy this file to `server/.env.neon` (ignored by git) and paste your two
# connection strings from the Neon console (Dashboard → Connect).
# This file is ONLY used by `npm run db:neon:status` / `npm run db:neon:deploy`.
# Vercel gets the same values through Project → Settings → Environment Variables.
#
# Pooled connection (host contains "-pooler"): used by the application at runtime.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
#
# Direct connection (host WITHOUT "-pooler"): used by Prisma Migrate.
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require"
#
# --- Production seed (npm run db:neon:seed) ---------------------------------
# OPTIONAL first administrator account. Leave BOTH lines commented out to skip it
# (roles, permissions, settings, hours and loyalty rules are still created).
# Use a real mailbox you control.
# Password: 14+ characters mixing at least 3 of lowercase/uppercase/digits/symbols.
# Generate one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url') + '!7a')"
# After a successful seed, DELETE the password line from .env.neon and change it in the app (Account → Password).
# PROD_ADMIN_EMAIL="<admin-email>"
# PROD_ADMIN_PASSWORD="<strong-password>"
